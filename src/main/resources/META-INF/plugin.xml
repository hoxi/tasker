<idea-plugin>
    <id>net.tagpad.tasker</id>
    <name>Tasker</name>
    <vendor>net.tagpad</vendor>

    <description><![CDATA[
        Lists all tasks from configured task servers in a sortable, groupable
        multi-column table with a details pane, docked in the bottom tool-window area.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.tasks</depends>
    <!-- JetLab opens GitLab links itself, so nothing is registered for it; see openLink. -->
    <depends optional="true" config-file="tasker-jetlab.xml">com.majera.intellij.codereview.gitlab</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Tasker" displayType="BALLOON"/>
        <toolWindow id="Tasks"
                    anchor="bottom"
                    icon="/icons/toolWindowTasker.svg"
                    factoryClass="net.tagpad.tasker.TaskerToolWindowFactory"/>
    </extensions>
</idea-plugin>
